# 仅用于本地开发的非生产默认值；生产环境必须由部署平台注入真实配置。
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000
POSTGRES_DB=crm_lead
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://crm:change-me-before-production@postgres:5432/crm_lead
REDIS_URL=redis://redis:6379/0
SMART_TABLE_ADAPTER=mock
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_SMART_TABLE_DOC_ID=
WECOM_SMART_TABLE_SHEET_ID=
# 当前 CLI 不支持读取这两项权限；仅填管理员刚刚核验过的实际布尔值。
# WECOM_SMART_TABLE_SALES_CAN_CREATE_RECORDS=false
# WECOM_SMART_TABLE_SALES_CAN_DELETE_RECORDS=false
WECOM_CLI_COMMAND=wecom-cli
WECOM_CLI_TIMEOUT_SECONDS=20
WECOM_CLI_RETRY_COUNT=1
LEAD_CONTEXT_TTL_MINUTES=30
LEAD_MESSAGE_RETRY_COUNT=1
LEAD_OUTBOX_POLL_SECONDS=10
LEAD_PROCESSING_TIMEOUT_SECONDS=300
# Qwen OpenAI 兼容 API；真实 Key 仅由本地 .env 或部署平台注入。
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
AI_GATEWAY_TIMEOUT_SECONDS=20
AI_GATEWAY_RETRY_COUNT=1
AI_HIGH_CONFIDENCE_THRESHOLD=0.85
AI_MEDIUM_CONFIDENCE_THRESHOLD=0.60
# 卡片不可可靠使用时，必填中置信度字段不得预填，须由销售在表格中填写。
ROBOT_SUBMISSION_CONFIRMATION_AVAILABLE=true
MEDIA_STORAGE_PATH=/var/lib/crm-lead/media
MEDIA_IMAGE_MIME_TYPES=["image/png","image/jpeg","image/webp"]
MEDIA_AUDIO_MIME_TYPES=["audio/mpeg","audio/wav","audio/mp4"]
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_AUDIO_BYTES=20971520
MEDIA_PROCESSING_TIMEOUT_SECONDS=20
OCR_PROVIDER=qwen
ASR_PROVIDER=qwen
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_ASR_MODEL=qwen3-asr-flash
# 本机 wecom-cli 的加密凭据目录；仅用于 Docker 只读挂载，禁止提交真实凭据。
# WECOM_CLI_CREDENTIALS_PATH=/absolute/path/to/.config/wecom
